{
  "name": "colio",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start -c",
    "android": "expo start --android -c",
    "ios": "expo start --ios -c",
    "web": "expo start --web",
    "test": "npx tsx --env-file=.env --test tests/colio.test.ts tests/qa.test.ts tests/auth.test.ts",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:prod": "eas build -p android --profile production",
    "build:status": "eas build:list",
    "postinstall": "node scripts/patch-expo-notifications.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "eas-cli": "^24.7.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
